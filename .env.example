NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
API_STORAGE=mongo
MONGO_URI=mongodb://localhost:27017/atellier_studio
ATELLIER_ROOT=../../atelier
VITE_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────────────────────
# Executor selection
# ─────────────────────────────────────────────────────────────────────────────
# AGENT_EXECUTOR_MODE: mock | openai | anthropic | groq | ollama
# - mock      → safe local dev, no LLM calls (default in dev)
# - openai    → real OpenAI runs, requires OPENAI_API_KEY
# - anthropic → real Anthropic runs (Opus 4.7 + naive prompt caching on
#               the system prompt), requires ANTHROPIC_API_KEY
# - groq      → real Groq runs over OpenAI-compatible endpoint, free tier,
#               requires GROQ_API_KEY (https://console.groq.com/keys)
# - ollama    → local Ollama runs over OpenAI-compatible endpoint, no API key
#               needed, requires OLLAMA_MODEL (and `ollama pull <model>` first)
AGENT_EXECUTOR_MODE=mock

AGENT_MAX_HANDOFF_DEPTH=1
AGENT_EXECUTION_TIMEOUT_MS=45000
MOCK_STEP_DELAY_MS=0

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI (used when AGENT_EXECUTOR_MODE=openai)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_MODEL_PROFILE: cheap | standard | deep
OPENAI_MODEL_PROFILE=standard

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic (used when AGENT_EXECUTOR_MODE=anthropic)
# Real call path is live: POST /v1/messages with cache_control: ephemeral on
# the system prompt for naive prompt caching across repeated runs.
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
# ANTHROPIC_MODEL_PROFILE: cheap | standard | deep
ANTHROPIC_MODEL_PROFILE=standard

# ─────────────────────────────────────────────────────────────────────────────
# Groq (used when AGENT_EXECUTOR_MODE=groq)
# OpenAI-compatible endpoint at https://api.groq.com/openai/v1.
# Free tier with generous quota. Get a key at https://console.groq.com/keys.
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL_PROFILE: cheap | standard | deep
GROQ_MODEL_PROFILE=standard

# ─────────────────────────────────────────────────────────────────────────────
# Ollama (used when AGENT_EXECUTOR_MODE=ollama)
# Local-only, no API key. Install + pull a model first:
#   brew install ollama && ollama pull llama3.2
# Default base URL is http://127.0.0.1:11434.
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_MODEL_PROFILE: cheap | standard | deep
OLLAMA_MODEL_PROFILE=standard
