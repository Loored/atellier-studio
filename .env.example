NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
API_STORAGE=mongo
MONGO_URI=mongodb://127.0.0.1:27017/atellier_studio
ATELLIER_ROOT=../../atelier
VITE_API_URL=http://127.0.0.1:4000
# Used by ./scripts/dev-local; Vite receives them as explicit CLI options.
WEB_HOST=127.0.0.1
WEB_PORT=5174

# ─────────────────────────────────────────────────────────────────────────────
# Executor selection
# ─────────────────────────────────────────────────────────────────────────────
# AGENT_EXECUTOR_MODE: mock | openai | anthropic | groq | ollama
# - mock      → safe local dev, no LLM calls (default in dev)
# - openai    → real OpenAI runs, requires OPENAI_API_KEY
# - anthropic → real Anthropic runs (Opus 4.7 + naive prompt caching on
#               the system prompt), requires ANTHROPIC_API_KEY
# - groq      → real Groq runs over OpenAI-compatible endpoint, free tier,
#               requires GROQ_API_KEY (https://console.groq.com/keys)
# - ollama    → local Ollama runs over OpenAI-compatible endpoint, no API key
#               needed, requires OLLAMA_MODEL (and `ollama pull <model>` first)
AGENT_EXECUTOR_MODE=mock

AGENT_MAX_HANDOFF_DEPTH=1
AGENT_EXECUTION_TIMEOUT_MS=240000
MOCK_STEP_DELAY_MS=0

# Reversible workspace changes may be previewed and reviewed, but applying or
# rolling them back is disabled by default. This remains an operator-only
# diagnostic opt-in while the durable state machine is being completed.
ATELLIER_REVERSIBLE_WORKSPACE_WRITES_ENABLED=false

# Approved code previews can be prepared and verified only in disposable,
# server-owned git worktrees. This never merges into the primary checkout.
ATELLIER_SUPERVISED_CODE_CHANGES_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI (used when AGENT_EXECUTOR_MODE=openai)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_MODEL_PROFILE: cheap | standard | deep
OPENAI_MODEL_PROFILE=standard

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic (used when AGENT_EXECUTOR_MODE=anthropic)
# Real call path is live: POST /v1/messages with cache_control: ephemeral on
# the system prompt for naive prompt caching across repeated runs.
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
# ANTHROPIC_MODEL_PROFILE: cheap | standard | deep
ANTHROPIC_MODEL_PROFILE=standard

# ─────────────────────────────────────────────────────────────────────────────
# Groq (used when AGENT_EXECUTOR_MODE=groq)
# OpenAI-compatible endpoint at https://api.groq.com/openai/v1.
# Free tier with generous quota. Get a key at https://console.groq.com/keys.
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL_PROFILE: cheap | standard | deep
GROQ_MODEL_PROFILE=standard

# ─────────────────────────────────────────────────────────────────────────────
# Ollama (used when AGENT_EXECUTOR_MODE=ollama)
# Local-only, no API key. Install + pull a model first:
#   brew install ollama && ollama pull qwen3.5:4b
# Default base URL is http://127.0.0.1:11434.
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Per-request context window. 8192 is the safe default for frozen Context
# Receipts on the lightweight local model; increase only after capacity tests.
OLLAMA_CONTEXT_TOKENS=8192
# Lightweight Qwen profiles run with reasoning disabled so bounded agent steps
# reserve their output budget for the requested artifact.
# OLLAMA_MODEL_PROFILE: cheap | standard | deep
OLLAMA_MODEL_PROFILE=standard
# Profile-based model routing. The selected profile wins over OLLAMA_MODEL.
OLLAMA_MODEL_CHEAP=qwen3.5:4b
# Ordinary orchestration stays on the lightweight model. The deep profile is
# reserved for bounded semantic repair after QA; steps are sequential and the
# local launcher keeps only one Ollama model loaded, avoiding concurrent VRAM use.
OLLAMA_MODEL_STANDARD=qwen3.5:4b
OLLAMA_MODEL_DEEP=qwen3.5:9b
# Optional legacy fallback when a profile-specific model is unset.
OLLAMA_MODEL=

# Per-agent-role overrides. Only kick in when AGENT_EXECUTOR_MODE=ollama and
# at least one of these is set. Unset roles fall back to the selected profile model.
# Structured QA uses 9B because measured 4B runs repeatedly ignored the bounded
# verdict/checklist contract. All other roles remain on the lightweight profile.
# OLLAMA_MODEL_INTAKE=
# OLLAMA_MODEL_WIKI_CURATOR=
# OLLAMA_MODEL_PM=
# OLLAMA_MODEL_BUILDER=qwen2.5-coder:7b
OLLAMA_MODEL_QA=qwen3.5:9b
# OLLAMA_MODEL_DESIGNER=
