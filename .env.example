NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
API_STORAGE=mongo
MONGO_URI=mongodb://localhost:27017/atellier_studio
ATELLIER_ROOT=../../atelier
VITE_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────────────────────
# Executor selection
# ─────────────────────────────────────────────────────────────────────────────
# AGENT_EXECUTOR_MODE: mock | openai | anthropic
# - mock      → safe local dev, no LLM calls (default in dev)
# - openai    → real OpenAI runs, requires OPENAI_API_KEY
# - anthropic → P3.a stub: env + /health wired; execute() throws until P3.b
#               (real Opus 4.7 + prompt caching). Requires ANTHROPIC_API_KEY.
AGENT_EXECUTOR_MODE=mock

AGENT_MAX_HANDOFF_DEPTH=1
AGENT_EXECUTION_TIMEOUT_MS=45000
MOCK_STEP_DELAY_MS=0

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI (used when AGENT_EXECUTOR_MODE=openai)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_MODEL_PROFILE: cheap | standard | deep
OPENAI_MODEL_PROFILE=standard

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic (used when AGENT_EXECUTOR_MODE=anthropic)
# P3.a stub: env + /health badge are live; execute() throws until P3.b lands
# the real call path (Opus 4.7 + prompt caching).
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
# ANTHROPIC_MODEL_PROFILE: cheap | standard | deep
ANTHROPIC_MODEL_PROFILE=standard
